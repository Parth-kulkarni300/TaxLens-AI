# TaxLens AI Environment Variables

# App Config
NEXT_PUBLIC_APP_NAME="TaxLens AI"
NEXT_PUBLIC_APP_TAGLINE="See Through Every Tax Charge"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI & LLM Provider (Configurable)
AI_PROVIDER=openai # openai | anthropic | gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OCR & Document Processing
OCR_PROVIDER=tesseract # tesseract | easyocr | cloud_vision
OCR_API_KEY=

# Database
DATABASE_URL=postgresql://taxlens:taxlens_secret@localhost:5432/taxlens_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
